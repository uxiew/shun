diff --git a/lib/src/widgets/terminal_controller_impl.dart b/lib/src/widgets/terminal_controller_impl.dart
index dd6196d..d71cb89 100644
--- a/lib/src/widgets/terminal_controller_impl.dart
+++ b/lib/src/widgets/terminal_controller_impl.dart
@@ -299,7 +299,11 @@ class TerminalControllerImpl extends TerminalController
       if (_extendSelection(event.logicalKey)) return .handled;
     }
 
-    final key = keyFromPhysical(event.physicalKey);
+    var key = keyFromPhysical(event.physicalKey);
+    // xwshun 实验：Android scanCode=0 的键物理键是合成值，按逻辑键兜底；处理后让输入法重新对齐。
+    final synthetic = key == vt.Key.unidentified &&
+        (event.physicalKey.usbHidUsage & 0xFF00000000) == 0x1100000000;
+    if (synthetic) key = _xwKeyFromLogical(event.logicalKey) ?? key;
     final KeyAction? action = switch (event) {
       KeyDownEvent() => .press,
       KeyUpEvent() => .release,
@@ -353,6 +357,9 @@ class TerminalControllerImpl extends TerminalController
     );
     _emitOutput(utf8.encode(result));
     _onTextInput();
+    if (synthetic && const bool.fromEnvironment('XW_RESYNC', defaultValue: true)) {
+      _textInput.resyncAfterKeyEdit();
+    }
 
     return forwardToPlatformIme ? .skipRemainingHandlers : .handled;
   }
@@ -1056,3 +1063,18 @@ class TerminalControllerImpl extends TerminalController
     return character;
   }
 }
+
+// xwshun 实验
+vt.Key? _xwKeyFromLogical(LogicalKeyboardKey k) {
+  const named = {
+    0x100000008: vt.Key.backspace, 0x10000000d: vt.Key.enter, 0x100000009: vt.Key.tab,
+    0x10000001b: vt.Key.escape, 0x100000304: vt.Key.arrowUp, 0x100000301: vt.Key.arrowDown,
+    0x100000302: vt.Key.arrowLeft, 0x100000303: vt.Key.arrowRight, 0x100000306: vt.Key.home,
+    0x100000305: vt.Key.end, 0x100000308: vt.Key.pageUp, 0x100000307: vt.Key.pageDown,
+    0x10000007f: vt.Key.delete,
+  };
+  final id = k.keyId;
+  if (named[id] case final key?) return key;
+  if (id >= 0x61 && id <= 0x7a) return vt.Key.values.byName(String.fromCharCode(id));
+  return null;
+}
