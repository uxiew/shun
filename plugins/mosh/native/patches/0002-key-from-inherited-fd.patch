   /* Read key from environment */
   char *env_key = getenv( "MOSH_KEY" );
-  if ( env_key == NULL ) {
+  /* xwshun: or from an inherited pipe named by MOSH_KEY_FD. The key then never enters the
+     environment: unsetenv() below does not erase the initial environment block, which stays
+     readable in /proc/<pid>/environ for the life of the process. */
+  string key;
+  const char *key_fd_env = getenv( "MOSH_KEY_FD" );
+  if ( env_key == NULL && key_fd_env != NULL ) {
+    char *end = NULL;
+    long fd = strtol( key_fd_env, &end, 10 );
+    if ( end == key_fd_env || *end != '\0' || fd < 3 || fd > 1023 ) {
+      fputs( "MOSH_KEY_FD is not a usable descriptor.\n", stderr );
+      exit( 1 );
+    }
+    char buf[ 23 ];
+    size_t got = 0;
+    while ( got < sizeof buf ) {
+      ssize_t n = read( (int) fd, buf + got, sizeof buf - got );
+      if ( n < 0 && errno == EINTR ) {
+        continue;
+      }
+      if ( n <= 0 ) {
+        break;
+      }
+      got += n;
+    }
+    close( (int) fd );
+    if ( got == 22 ) {
+      key.assign( buf, 22 );
+    }
+    for ( volatile char *v = buf; v < buf + sizeof buf; v++ ) {
+      *v = 0;
+    }
+    if ( key.empty() ) {
+      fputs( "MOSH_KEY_FD did not carry exactly one 22-character key.\n", stderr );
+      exit( 1 );
+    }
+    unsetenv( "MOSH_KEY_FD" );
+  } else if ( env_key == NULL ) {
     fputs( "MOSH_KEY environment variable not found.\n", stderr );
     exit( 1 );
   }
